# Application
APP_ENV=development
APP_NAME=trazo
BACKEND_PORT=8000
FRONTEND_PORT=5173
LOG_LEVEL=INFO
# Required: generate a random secret of at least 32 characters before starting the API.
AUTH_SECRET=
AUTH_TOKEN_TTL_MINUTES=480

# Trazo database (separate from Lemoria's PostgreSQL)
POSTGRES_DB=trazo_db
POSTGRES_USER=trazo_app
POSTGRES_PASSWORD=trazo_local_password
POSTGRES_PORT=5433
DATABASE_URL=postgresql+psycopg://trazo_app:trazo_local_password@db:5432/trazo_db

# Browser access to the API
CORS_ORIGINS=http://localhost:5173

# Optional AI integration (leave empty to disable)
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
