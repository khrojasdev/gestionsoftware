# Copia este archivo como .env (opcional para uso local con Docker).
# Nunca subas .env al repositorio.

# Entorno: development | production
APP_ENV=development
LOG_LEVEL=INFO

# Clave para firmar las sesiones (mínimo 32 caracteres). Obligatoria en producción.
# Genera una con:  python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET=
AUTH_TOKEN_TTL_MINUTES=480

# Base de datos local (docker compose)
POSTGRES_DB=trazo_db
POSTGRES_USER=trazo_app
POSTGRES_PASSWORD=trazo_local_password
POSTGRES_PORT=5433
APP_PORT=8000

# Para ejecutar el backend fuera de Docker (uvicorn) contra la base del compose:
DATABASE_URL=postgresql+psycopg://trazo_app:trazo_local_password@localhost:5433/trazo_db

# Orígenes permitidos para el navegador (solo importa si el frontend corre en otro puerto)
CORS_ORIGINS=http://localhost:5173,http://localhost:8000

# Carga los proyectos y usuarios de demostración si la base está vacía
DEMO_SEED=true

# Carpeta de evidencias subidas (por defecto backend/data/uploads)
# UPLOAD_DIR=
