  "KPI_Proyecto_Hitos": [
    {
      "codigo": "P01",
      "nombre": "Índice de desempeño del cronograma (SPI)",
      "formula": "EV / PV",
      "ambito": "PROYECTO",
      "categoria": "PROYECTO",
      "meta": 1,
      "verde": 0.95,
      "amarillo": 0.9,
      "unidad": "índice",
      "adicional": "",
      "descripcion": "Valor ganado sobre valor planificado a la fecha de corte."
    },
    {
      "codigo": "P02",
      "nombre": "Índice de desempeño de costo (CPI)",
      "formula": "EV / AC",
      "ambito": "PROYECTO",
      "categoria": "PROYECTO",
      "meta": 1,
      "verde": 0.95,
      "amarillo": 0.9,
      "unidad": "índice",
      "adicional": "",
      "descripcion": "Valor ganado sobre costo real a la fecha de corte."
    },
    {
      "codigo": "P03",
      "nombre": "Variación del cronograma (SV)",
      "formula": "EV - PV",
      "ambito": "PROYECTO",
      "categoria": "PROYECTO",
      "meta": 0,
      "verde": 0,
      "amarillo": -2000000,
      "unidad": "CLP",
      "adicional": "",
      "descripcion": "Diferencia entre valor ganado y valor planificado."
    },
    {
      "codigo": "P04",
      "nombre": "Variación de costo (CV)",
      "formula": "EV - AC",
      "ambito": "PROYECTO",
      "categoria": "PROYECTO",
      "meta": 0,
      "verde": 0,
      "amarillo": -2000000,
      "unidad": "CLP",
      "adicional": "",
      "descripcion": "Diferencia entre valor ganado y costo real."
    },
    {
      "codigo": "P05",
      "nombre": "Desviación de avance físico",
      "formula": "AVANCE_REAL - AVANCE_PLAN",
      "ambito": "PROYECTO",
      "categoria": "PROYECTO",
      "meta": 0,
      "verde": -2,
      "amarillo": -5,
      "unidad": "pp",
      "adicional": "",
      "descripcion": "Avance real menos avance planificado, en puntos porcentuales."
    },
    {
      "codigo": "P06",
      "nombre": "Actividades atrasadas",
      "formula": "count(ACTIVIDADES_ATRASADAS) / count(ACTIVIDADES) * 100",
